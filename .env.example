# ---------------------------------------------------------------------------
# Copy to `.env` (Prisma reads `.env`; Next reads it too) and fill in.
# ---------------------------------------------------------------------------

# MySQL — `mysql://USER:PASSWORD@HOST:PORT/DATABASE`
DATABASE_URL="mysql://root:password@localhost:3306/smileon"

# Auth.js — generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_URL="http://localhost:3000"

# Public site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Media storage: "local" writes to ./public/uploads, "s3" uses the bucket below
STORAGE_DRIVER="local"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL=""

# Outgoing mail. Leave SMTP_HOST empty in development to log emails to stdout.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
MAIL_FROM="SmileOn <no-reply@smileon.pk>"
# Where appointment / contact notifications are delivered
MAIL_TO="frontdesk@smileon.pk"
